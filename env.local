# ─── Supabase ────────────────────────────────────────────────────────────────
# Both vars come from: Supabase → Project Settings → API

# Safe to expose to the browser (anon key, RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Used by supabaseServer.ts (bypasses RLS). Keep out of version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Cron / API auth ─────────────────────────────────────────────────────────
# Protects /api/intelligence/run, /api/outreach/send|discover|import|sync
# Generate with: openssl rand -hex 32
# Vercel Cron sends this automatically when set in the Vercel dashboard.
# For manual calls: Authorization: Bearer <this-value>
CRON_SECRET=your-cron-secret-here

# ─── YouTube Data API ────────────────────────────────────────────────────────
# Required for YT discovery and email personalisation (getBestVideo)
# console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# ─── Outreach email (Gmail) ───────────────────────────────────────────────────
# Gmail account used to send outreach and check replies via IMAP
# Use an App Password, not your real password:
# Google Account → Security → 2-Step Verification → App passwords
OUTREACH_EMAIL=you@gmail.com
OUTREACH_EMAIL_PASSWORD=your-gmail-app-password-here

# ─── Currency (optional) ─────────────────────────────────────────────────────
# exchange rate fetched live from open.er-api.com — no key needed.
# Fallback rate (₹84 per $1) is used if the fetch fails.
